{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z2-9]{6}$/)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('createdAt').val() >= now - 60000 && newData.child('createdAt').val() <= now + 60000) || data.child('host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['host','createdAt','hostHero']) && $code.matches(/^[A-Z2-9]{6}$/)",
        "host": {".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"},
        "createdAt": {".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"},
        "hostHero": {".validate": "newData.isString() && newData.val().length < 40"},
        "guest": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').exists() && root.child('rooms').child($code).child('host').val() !== auth.uid && root.child('rooms').child($code).child('createdAt').val() > now - 7200000 && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString() && newData.val().length < 128"
        },
        "guestHero": {".write": "auth != null && root.child('rooms').child($code).child('guest').val() === auth.uid", ".validate": "newData.isString() && newData.val().length < 40"},
        "offer": {".validate": "newData.hasChildren(['type','sdp']) && newData.child('sdp').isString() && newData.child('sdp').val().length < 20000 && newData.child('type').val() === 'offer'"},
        "answer": {".write": "auth != null && root.child('rooms').child($code).child('guest').val() === auth.uid", ".validate": "newData.hasChildren(['type','sdp']) && newData.child('sdp').isString() && newData.child('sdp').val().length < 20000 && newData.child('type').val() === 'answer'"},
        "hostIce": {"$id": {".validate": "newData.child('candidate').isString() && newData.child('candidate').val().length < 3000"}},
        "guestIce": {".write": "auth != null && root.child('rooms').child($code).child('guest').val() === auth.uid", "$id": {".validate": "newData.child('candidate').isString() && newData.child('candidate').val().length < 3000"}},
        "$other": {".validate": false}
      }
    }
  }
}
